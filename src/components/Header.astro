---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Estudio</HeaderLink>
			<HeaderLink href="/producciones">Producciones</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		margin: 0;
		padding: 0 1em;
		background: var(--colorBg-transparent);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		backdrop-filter: blur(10px);
		z-index: 10;
	}
	h2 {
		font-size: 1em;
		border-bottom: var(--color-macaroni-and-cheese-500) inset 2px;
		width: fit-content;

	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap:10px;
	}
	nav a {
		padding: 1em 0.5em;
		color: white;
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--color-macaroni-and-cheese-500);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
